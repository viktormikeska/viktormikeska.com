---
import BaseLayout from './BaseLayout.astro';
import Tags from '../components/Tags.astro';
import Icon from '../components/Icon.astro';
import { formatDate, type Writeup } from '../lib/writeups';
import { site } from '../data/site';

interface Props {
  writeup: Writeup;
  /** Archive page listing this writeup. */
  backUrl: string;
}

const { writeup, backUrl } = Astro.props;
const { title, summary, date, updated, tags, draft, image } = writeup.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = (image ?? site.ogImage) ? new URL((image ?? site.ogImage)!, Astro.site) : undefined;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  ...(imageURL && { image: imageURL.toString() }),
  keywords: tags.join(', '),
  url: canonicalURL.toString(),
  mainEntityOfPage: canonicalURL.toString(),
  inLanguage: 'en',
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<BaseLayout
  title={title}
  description={summary}
  image={image}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  tags={tags}
  jsonLd={articleJsonLd}
  noindex={draft}
>
  <article class="writeup container">
    <header class="writeup__header reveal">
      <a href={backUrl} class="writeup__back">
        <Icon name="arrow-left" /> All writeups
      </a>
      <h1 class="writeup__title">{title}</h1>
      <p class="writeup__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <span>
              · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </span>
          )
        }
        {draft && <span class="writeup__draft">draft — not published</span>}
      </p>
      <Tags tags={tags} />
    </header>

    <div class="prose reveal" style="--i: 1">
      <slot />
    </div>

    <footer class="writeup__footer">
      <a href={backUrl} class="text-link">← All writeups</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .writeup__header {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .writeup__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    justify-self: start;
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .writeup__back:hover {
    color: var(--color-accent);
  }

  .writeup__back :global(svg) {
    width: 14px;
    height: 14px;
  }

  .writeup__title {
    font-size: var(--fs-xl);
    line-height: 1.2;
    text-wrap: balance;
  }

  .writeup__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-1);
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
  }

  .writeup__draft {
    color: var(--color-accent);
  }

  .writeup__footer {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
  }

  /* Long-form body: readable sans at a comfortable measure; mono only for code. */
  .prose {
    font-family: var(--font-sans);
    font-size: var(--fs-prose);
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(> * + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 2.25em;
    font-size: 1.25rem;
  }

  .prose :global(h3) {
    margin-top: 1.75em;
    font-size: 1.0625rem;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.75em;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    text-underline-offset: 0.2em;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .prose :global(strong) {
    font-weight: 650;
    color: #fff;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--color-text-secondary);
  }

  .prose :global(blockquote) {
    padding-left: 1.25em;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-secondary);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: 2.5em;
  }

  .prose :global(img) {
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.125em 0.375em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.65;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow-x: auto;
    tab-size: 2;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.5em 0.75em;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* Copy button added to each code block by the script below. */
  .prose :global(.code-block) {
    position: relative;
  }

  .prose :global(.code-block__copy) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .prose :global(.code-block:hover .code-block__copy),
  .prose :global(.code-block__copy:focus-visible),
  .prose :global(.code-block__copy[data-copied]) {
    opacity: 1;
  }

  .prose :global(.code-block__copy:hover),
  .prose :global(.code-block__copy[data-copied]) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Touch screens have no hover, so keep the button visible. */
  @media (hover: none) {
    .prose :global(.code-block__copy) {
      opacity: 1;
    }
  }

  @media (max-width: 34rem) {
    .prose {
      font-size: 1.0625rem;
    }

    .prose :global(pre) {
      margin-inline: calc(var(--space-3) * -1);
      border-radius: 0;
      border-inline: 0;
    }
  }
</style>

<script>
  // Progressive enhancement: wrap each code block and add a copy button.
  // Skipped where the Clipboard API isn't available (non-HTTPS, old browsers).
  if (navigator.clipboard) {
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);
      wrapper.append(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-block__copy';
      button.textContent = 'copy';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.setAttribute('aria-live', 'polite');
      wrapper.append(button);

      let resetTimer: number | undefined;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          button.textContent = 'copied';
        } catch {
          button.textContent = 'failed';
        }
        button.toggleAttribute('data-copied', true);
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          button.textContent = 'copy';
          button.removeAttribute('data-copied');
        }, 2000);
      });
    }
  }
</script>
