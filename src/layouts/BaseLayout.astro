---
import '../styles/global.css';
import { socials } from '../data/socials';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Viktor Mikeska',
  description = 'Builder, QA & Product specialist working across Web3 and AI-powered web and mobile applications. Shipping products people actually enjoy using.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Viktor Mikeska',
  url: Astro.site?.toString() ?? 'https://viktormikeska.com',
  jobTitle: 'Builder, QA & Product Specialist',
  description,
  sameAs: socials.filter((s) => !s.href.startsWith('mailto:')).map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08080c" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Viktor Mikeska" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="Viktor Mikeska" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
