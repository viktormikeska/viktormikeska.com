---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title without the site suffix; omit on the home page. */
  title?: string;
  description?: string;
  /** Social preview image, path relative to /public. Falls back to site.ogImage. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Structured data object(s) rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Delay (ms) before the content reveal starts — set to the duration of the page's typed command. */
  revealStart?: number;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  noindex = false,
  revealStart = 0,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1214" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}

    <script is:inline>
      (() => {
        const html = document.documentElement;
        html.classList.add('js');

        // The intro (typed command + content reveal) plays on a fresh visit or
        // reload, but not when going back, nor when moving around inside the
        // writeups section (list ⇄ writeup, paging), where it would get tiresome.
        try {
          const navType = performance.getEntriesByType('navigation')[0]?.type;
          const inWriteups = (path) => /^\/writeups(\/|$)/.test(path);
          const referrer = document.referrer ? new URL(document.referrer) : null;
          const withinWriteups =
            referrer?.origin === location.origin &&
            inWriteups(referrer.pathname) &&
            inWriteups(location.pathname);

          if (navType === 'back_forward' || (navType === 'navigate' && withinWriteups)) {
            html.classList.add('skip-intro');
          }
        } catch {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Writeups`}
      href={new URL('/rss.xml', Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={site.name} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@viktormikeska" />
    <meta name="twitter:creator" content="@viktormikeska" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" style={`--reveal-start: ${revealStart}ms`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
