---
import Tags from './Tags.astro';
import { formatDate, type Writeup } from '../lib/writeups';

interface Props {
  writeups: Writeup[];
  /** Heading level for each item title, to keep the document outline in order. */
  headingLevel?: 'h2' | 'h3';
}

const { writeups, headingLevel: Heading = 'h2' } = Astro.props;
---

{
  writeups.length > 0 ? (
    <ol role="list" class="writeup-list">
      {writeups.map((writeup) => (
        <li>
          <article class="writeup-item">
            <Heading class="writeup-item__title">
              <a href={`/writeups/${writeup.id}/`}>{writeup.data.title}</a>
            </Heading>
            <p class="writeup-item__meta">
              <time datetime={writeup.data.date.toISOString()}>{formatDate(writeup.data.date)}</time>
              {writeup.data.draft && <span class="draft-badge">draft</span>}
            </p>
            <p class="writeup-item__summary">{writeup.data.summary}</p>
            <Tags tags={writeup.data.tags} />
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty-state">
      <p>No writeups yet — the first one is on its way.</p>
    </div>
  )
}

<style>
  .writeup-list {
    display: grid;
  }

  .writeup-list > li + li {
    border-top: 1px solid var(--color-border);
  }

  .writeup-item {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding-block: var(--space-3);
  }

  .writeup-item__title {
    font-size: var(--fs-lg);
    order: 1;
  }

  .writeup-item__meta {
    order: 0;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
  }

  .writeup-item__summary {
    order: 2;
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .writeup-item :global(.tags) {
    order: 3;
    margin-top: 0.25rem;
  }

  /* Whole card is clickable via the title link's pseudo-element. */
  .writeup-item__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .writeup-item__title a {
    transition: color 0.15s ease;
  }

  .writeup-item:hover .writeup-item__title a {
    color: var(--color-accent);
  }

  .writeup-item__title a:focus-visible {
    outline: none;
  }

  .writeup-item:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .draft-badge {
    padding: 0 0.375rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .empty-state {
    padding: var(--space-4) var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
  }
</style>
