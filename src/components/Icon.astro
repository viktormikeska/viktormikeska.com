---
export type IconName =
  | 'linkedin'
  | 'x'
  | 'github'
  | 'youtube'
  | 'telegram'
  | 'menu'
  | 'close'
  | 'arrow-right'
  | 'arrow-up'
  | 'email';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
