---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul role="list" class="tags" aria-label="Tags">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tags li {
    padding: 0.125rem 0.5rem;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 4px;
  }
</style>
