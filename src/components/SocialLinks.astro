---
import Icon from './Icon.astro';
import EmailLink from './EmailLink.astro';
import { socials } from '../data/socials';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul role="list" class:list={['social-links', className]}>
  {
    socials.map((social) => (
      <li>
        <a href={social.href} rel="me noopener noreferrer" target="_blank">
          <Icon name={social.id} />
          <span class="social-links__label">{social.label}</span>
        </a>
      </li>
    ))
  }
  <li>
    <EmailLink><Icon name="email" /></EmailLink>
  </li>
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .social-links :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem;
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .social-links :global(a:hover) {
    color: var(--color-accent);
  }

  .social-links :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Mobile: icons only, so the row fits on one line. Labels stay in the DOM
     (visually hidden) as each link's accessible name. */
  @media (max-width: 34rem) {
    /* The negative margin lines the first icon up with the text edge
       despite its tap padding. */
    .social-links {
      flex-wrap: nowrap;
      gap: 0.25rem;
      margin-left: -0.625rem;
    }

    .social-links :global(a) {
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
    }

    .social-links :global(svg) {
      width: 24px;
      height: 24px;
    }

    .social-links__label,
    .social-links :global(.email-link__text) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
