---
import Icon from './Icon.astro';
---

<button id="back-to-top" class="back-to-top" aria-label="Back to top">
  <Icon name="arrow-up" />
</button>

<style>
  .back-to-top {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-text-secondary);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .back-to-top :global(svg) {
    width: 24px;
    height: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition:
        opacity 0.01ms,
        color 0.01ms,
        border-color 0.01ms;
      transform: none;
    }
  }
</style>

<script>
  const button = document.getElementById('back-to-top');
  const header = document.getElementById('site-header');
  const bioSection = document.getElementById('bio');

  // Match the same activation line the header's scrollspy uses, so the
  // button appears at the exact moment "About Me" lights up.
  const headerHeight = header?.getBoundingClientRect().height ?? 72;
  const activationLine = headerHeight + 24;

  const updateVisibility = () => {
    const bioTop = bioSection?.getBoundingClientRect().top ?? Infinity;
    button?.classList.toggle('visible', bioTop <= activationLine);
  };

  button?.addEventListener('click', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
    // No section is "active" at the top, so drop the hash from the URL.
    history.replaceState(null, '', window.location.pathname + window.location.search);
  });

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateVisibility();
        ticking = false;
      });
    },
    { passive: true }
  );

  updateVisibility();
</script>
