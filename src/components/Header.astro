---
import { navItems } from '../data/nav';
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const target = href.replace(/\/$/, '') || '/';
  return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">{site.name}</a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <div class="site-nav__inner">
        <ul role="list">
          {
            navItems.map((item, i) => (
              <li style={`--i: ${i}`}>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    min-height: 4rem;
  }

  .brand {
    font-weight: 600;
    font-size: var(--fs-sm);
    padding-block: var(--space-1);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-3);
  }

  .site-nav a {
    display: block;
    padding-block: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--color-text);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    border-radius: var(--radius);
    transition: color 0.15s ease;
  }

  .nav-toggle:hover,
  .nav-toggle[aria-expanded='true'] {
    color: var(--color-text);
  }

  /* Hamburger drawn with CSS so it can morph into a cross: the middle bar
     fades out while the outer two rotate into an X. */
  .nav-toggle__icon {
    position: relative;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: background-color 0.2s ease;
  }

  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    background: currentColor;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav-toggle__icon::before {
    transform: translateY(-6px);
  }

  .nav-toggle__icon::after {
    transform: translateY(6px);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon {
    background-color: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::before {
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::after {
    transform: rotate(-45deg);
  }

  /* Mobile: the nav becomes a panel that slides open below the header bar,
     over the page. Only when JS can toggle it; without JS the links wrap. */
  @media (max-width: 34rem) {
    :global(.js) .nav-toggle {
      display: flex;
    }

    :global(.js) .site-nav {
      position: absolute;
      /* Below the header's bottom border, so the bar looks the same open or closed. */
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      display: grid;
      /* Animating 0fr → 1fr expands to the content's natural height. */
      grid-template-rows: 0fr;
      visibility: hidden;
      background: var(--color-bg);
      border-bottom: 1px solid transparent;
      box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0);
      transition:
        grid-template-rows 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        visibility 0s linear 0.35s;
    }

    :global(.js) .site-nav[data-open] {
      grid-template-rows: 1fr;
      visibility: visible;
      border-bottom-color: var(--color-border);
      box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.6);
      transition:
        grid-template-rows 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        visibility 0s;
    }

    :global(.js) .site-nav__inner {
      min-height: 0;
      overflow: hidden;
    }

    :global(.js) .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-1) var(--space-3) var(--space-2);
    }

    :global(.js) .site-nav li {
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    :global(.js) .site-nav[data-open] li {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.3s ease calc(80ms + var(--i) * 50ms),
        transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) calc(80ms + var(--i) * 50ms);
    }

    :global(.js) .site-nav a {
      padding-block: 0.75rem;
      font-size: var(--fs-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .site-nav,
    :global(.js) .site-nav[data-open],
    :global(.js) .site-nav li,
    :global(.js) .site-nav[data-open] li {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');

  if (header && toggle && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Close on Escape, on a click outside the header, and on any nav link
    // (covers links to the current page, which don't navigate away).
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    // Reset when the viewport grows past the mobile breakpoint.
    matchMedia('(max-width: 34rem)').addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });
  }
</script>
