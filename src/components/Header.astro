---
import Icon from './Icon.astro';
import { navItems } from '../data/nav';
---

<header class="header" id="site-header">
  <div class="container">
    <div class="header__inner">
      <div class="header__backdrop" aria-hidden="true"></div>
      <nav class="nav" id="site-nav" aria-label="Primary">
        <ul class="nav__list">
          {
            navItems.map((item) => (
              <li>
                <a href={`#${item.id}`} data-nav-id={item.id}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        class="hamburger"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Toggle navigation menu"
      >
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    --pill-height: 52px;
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    display: flex;
    align-items: flex-start;
    padding-top: calc((var(--header-height) - var(--pill-height)) / 2);
    /* The bar itself is invisible; only the pill is interactive so the page
       underneath stays clickable around it. */
    pointer-events: none;
  }

  .header > .container {
    pointer-events: none;
  }

  /* Floating pill, exactly as wide as the content column (.container's inner
     box). The blur/tint lives on its own layer so backdrop-filter doesn't sit
     on an ancestor of .nav — backdrop-filter creates a containing block for
     position:fixed descendants, which would break the mobile nav panel's
     fixed positioning relative to the viewport. */
  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    height: var(--pill-height);
    padding-inline: var(--space-3);
    pointer-events: auto;
  }

  .header__backdrop {
    position: absolute;
    inset: 0;
    /* Half the collapsed height: a full pill when closed, softly rounded
       when the mobile menu expands it. */
    border-radius: calc(var(--pill-height) / 2);
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent),
      0 8px 32px rgb(0 0 0 / 0.35);
  }

  .nav {
    position: relative;
  }

  .nav__list {
    display: flex;
    gap: var(--space-4);
  }

  .nav__list a {
    position: relative;
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    padding-block: var(--space-1);
    transition: color 0.2s ease;
  }

  .nav__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav__list a:hover {
    color: var(--color-text);
  }

  .nav__list a.active {
    color: var(--color-text);
  }

  .nav__list a.active::after {
    transform: scaleX(1);
  }

  .hamburger {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .hamburger :global(svg) {
    width: 22px;
    height: 22px;
  }

  .hamburger :global(.icon-close) {
    display: none;
  }

  .hamburger[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }

  .hamburger[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 720px) {
    /* The pill itself expands: the hamburger row stays on top and the link
       list grows out beneath it (grid-template-rows 0fr -> 1fr), while the
       glass layer simply follows the container's height. */
    .header__inner {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: var(--pill-height) auto;
      row-gap: 0;
      height: auto;
      padding-inline: var(--space-2);
    }

    .hamburger {
      display: flex;
      grid-row: 1;
      justify-self: end;
    }

    .nav {
      grid-row: 2;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows 0.3s ease,
        visibility 0s linear 0.3s;
    }

    .nav.nav-open {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows 0.3s ease,
        visibility 0s;
    }

    .nav__list {
      flex-direction: column;
      gap: 0;
      min-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .nav.nav-open .nav__list {
      opacity: 1;
      transition: opacity 0.25s ease 0.1s;
    }

    .nav__list li:last-child {
      padding-bottom: var(--space-1);
    }

    /* No underline or dividers on mobile — the active item is marked by
       colour only. */
    .nav__list a::after {
      display: none;
    }

    .nav__list a.active {
      color: var(--color-accent);
    }

    .nav__list a {
      display: block;
      padding: var(--space-2) var(--space-1);
      font-size: var(--fs-lg);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const pill = document.querySelector('.header__inner');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-id]'));

  const closeMenu = () => {
    nav?.classList.remove('nav-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  let openedAtScroll = 0;

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    openedAtScroll = window.scrollY;
  });

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (event) => {
    if (!nav?.classList.contains('nav-open')) return;
    const target = event.target as Node;
    if (!pill?.contains(target)) {
      closeMenu();
    }
  });

  const headerHeight = header?.getBoundingClientRect().height ?? 72;
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.navId ?? ''))
    .filter((el): el is HTMLElement => Boolean(el));

  const clearActive = () => {
    navLinks.forEach((link) => link.classList.remove('active'));
  };

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      link.classList.toggle('active', link.dataset.navId === id);
    });
  };

  // The active section is whichever one's top edge we've most recently
  // scrolled past — walk sections in document order and keep the last one
  // whose top is above the activation line (just below the header). If none
  // qualify yet (still up in the hero area, which has no nav link), nothing
  // is highlighted.
  const activationLine = headerHeight + 24;

  const updateActiveSection = () => {
    // Near the bottom of the page the last section may be too short for its
    // top to ever reach the activation line (there's still its own padding
    // and the footer left to scroll through) — treat "close to the bottom"
    // as "the last section is active" so the highlight isn't stuck lagging
    // behind until scrolling is 100% maxed out.
    const atBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 150;

    if (atBottom) {
      const last = sections[sections.length - 1];
      if (last) setActive(last.id);
      return;
    }

    let current: HTMLElement | null = null;

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= activationLine) {
        current = section;
      } else {
        break;
      }
    }

    if (current) {
      setActive(current.id);
    } else {
      clearActive();
    }
  };

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (
          nav?.classList.contains('nav-open') &&
          Math.abs(window.scrollY - openedAtScroll) > 80
        ) {
          closeMenu();
        }
        updateActiveSection();
        ticking = false;
      });
    },
    { passive: true }
  );

  updateActiveSection();
</script>
